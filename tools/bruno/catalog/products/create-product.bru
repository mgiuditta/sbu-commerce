meta {
  name: Create Product
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/products
  body: json
  auth: none
}

body:json {
  {
    "code": "PROD-001",
    "name": {
      "en": "Wireless Headphones",
      "it": "Cuffie Wireless"
    },
    "description": {
      "en": "Premium wireless headphones with noise cancellation",
      "it": "Cuffie wireless premium con cancellazione del rumore"
    },
    "status": "ACTIVE",
    "price": 149.99,
    "ean": "8001234567890",
    "manufacturerName": "SBU Audio",
    "summary": "Premium wireless headphones"
  }
}

tests {
  test("should return 201", function() {
    expect(res.getStatus()).to.equal(201);
  });

  test("should return product with id", function() {
    expect(res.getBody().id).to.be.a('string');
    expect(res.getBody().code).to.equal("PROD-001");
  });
}

script:post-response {
  if (res.getStatus() === 201) {
    bru.setVar("productId", res.getBody().id);
  }
}
