meta {
  name: Update Product
  type: http
  seq: 4
}

patch {
  url: {{baseUrl}}/products/{{productId}}
  body: json
  auth: none
}

body:json {
  {
    "price": 129.99,
    "status": "ACTIVE",
    "name": {
      "en": "Wireless Headphones Pro",
      "it": "Cuffie Wireless Pro"
    }
  }
}

tests {
  test("should return 200", function() {
    expect(res.getStatus()).to.equal(200);
  });

  test("should return updated price", function() {
    expect(res.getBody().price).to.equal("129.99");
  });
}
