{
  "name": "sbu-commerce",
  "version": "0.0.1",
  "private": true,
  "packageManager": "pnpm@9.15.4",
  "description": "Enterprise commerce platform — NestJS microservices + Next.js",
  "license": "BUSL-1.1",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
