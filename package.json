    "db:sync": "sbu db:sync"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "eslint": "^9.22.0",
    "prettier": "^3.5.3",
    "tsx": "^4.0.0",
    "turbo": "^2.4.4",
    "typescript": "^5.8.2"
  }
