      "attributes": [
        { "name": "code", "type": "string", "unique": true, "required": true },
        { "name": "name", "type": "LocalizedString", "required": true },
        { "name": "calculationType", "type": "TaxCalculationType", "default": "PERCENTAGE" },
        { "name": "value", "type": "decimal", "required": true },
        { "name": "currency", "type": "Currency", "relation": "many-to-one" },
        { "name": "country", "type": "Country", "relation": "many-to-one" },
        { "name": "region", "type": "Region", "relation": "many-to-one" },
        { "name": "active", "type": "boolean", "default": true }
      ]
    },
    {
      "code": "TaxRow",
      "extends": "GenericItem",
      "table": "tax_rows",
      "attributes": [
        { "name": "product", "type": "string", "required": true },
        { "name": "tax", "type": "Tax", "relation": "many-to-one", "required": true },
        { "name": "startDate", "type": "datetime" },
        { "name": "endDate", "type": "datetime" },
        { "name": "catalogVersion", "type": "string" }
      ]
    },
    {
      "code": "PaymentMode",
      "extends": "GenericItem",
      "table": "payment_modes",
      "attributes": [
        { "name": "code", "type": "string", "unique": true, "required": true },
        { "name": "name", "type": "LocalizedString", "required": true },
        { "name": "description", "type": "LocalizedString" },
        { "name": "paymentModeType", "type": "PaymentModeType", "required": true },
        { "name": "active", "type": "boolean", "default": true },
        { "name": "paymentProvider", "type": "string" },
        { "name": "sortOrder", "type": "integer", "default": 0 }
      ]
    },
    {
      "code": "PaymentInfo",
      "extends": "GenericItem",
      "table": "payment_infos",
      "attributes": [
        { "name": "code", "type": "string", "unique": true, "required": true },
        { "name": "customer", "type": "Customer", "relation": "many-to-one", "required": true },
        { "name": "paymentMode", "type": "PaymentMode", "relation": "many-to-one", "required": true },
        { "name": "billingAddress", "type": "Address", "relation": "many-to-one" },
        { "name": "cardType", "type": "string" },
        { "name": "cardNumber", "type": "string" },
        { "name": "cardHolder", "type": "string" },
        { "name": "expiryMonth", "type": "integer" },
        { "name": "expiryYear", "type": "integer" },
        { "name": "subscriptionId", "type": "string" },
        { "name": "saved", "type": "boolean", "default": false },
        { "name": "defaultPayment", "type": "boolean", "default": false }
      ]
    },
    {
      "code": "PaymentTransaction",
      "extends": "GenericItem",
