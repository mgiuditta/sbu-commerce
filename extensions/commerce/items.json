      "attributes": [
        { "name": "code", "type": "string", "unique": true, "required": true },
        { "name": "order", "type": "Order", "relation": "many-to-one", "required": true },
        { "name": "paymentInfo", "type": "PaymentInfo", "relation": "many-to-one" },
        { "name": "transactionType", "type": "PaymentTransactionType", "required": true },
        { "name": "status", "type": "PaymentTransactionStatus", "default": "PENDING" },
        { "name": "amount", "type": "decimal", "required": true },
        { "name": "currency", "type": "Currency", "relation": "many-to-one", "required": true },
        { "name": "providerTransactionId", "type": "string" },
        { "name": "providerResponse", "type": "map" },
        { "name": "requestId", "type": "string" },
        { "name": "processedAt", "type": "datetime" }
      ]
    },
    {
      "code": "DeliveryMode",
      "extends": "GenericItem",
      "table": "delivery_modes",
      "attributes": [
        { "name": "code", "type": "string", "unique": true, "required": true },
        { "name": "name", "type": "LocalizedString", "required": true },
        { "name": "description", "type": "LocalizedString" },
        { "name": "deliveryModeType", "type": "DeliveryModeType", "default": "STANDARD" },
        { "name": "active", "type": "boolean", "default": true },
